Algoritmo "38"
// 38) Escreva um programa que mostre na tela a seguinte contagem:
// 6 7 8 9 10 11 Acabou!
Var

   contador: inteiro

Inicio

      contador <- 5
      
      enquanto contador <= 11 faca
               escreva(contador)
               contador <- contador+1
      fimenquanto
      
      escreva(" Acabou!")

Fimalgoritmo